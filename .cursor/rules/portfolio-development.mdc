### 8. Contact Section (src/sections/Contact.tsx)

Facilite o contato com um formulário elegante.

Design: Formulário simples com ícones sociais.
Interatividade: Campos animados ao focar.
Implementação:

```
import styled from 'styled-components';
import { motion } from 'framer-motion';
import { FaGithub, FaLinkedin } from 'react-icons/fa';

const ContactWrapper = styled.section`
  padding: 4rem 2rem;
  text-align: center;
`;

const Input = styled(motion.input)`
  padding: 0.5rem;
  margin: 0.5rem 0;
  width: 100%;
  max-width: 400px;
`;

export default function Contact() {
  return (
    <ContactWrapper id="contact">
      <h2>Entre em Contato</h2>
      <form>
        <Input
          placeholder="Nome"
          whileFocus={{ scale: 1.05 }}
          transition={{ type: 'spring' }}
        />
        <Input placeholder="Email" whileFocus={{ scale: 1.05 }} />
        <Input placeholder="Mensagem" whileFocus={{ scale: 1.05 }} />
        <motion.button type="submit" whileHover={{ scale: 1.1 }}>
          Enviar
        </motion.button>
      </form>
      <div>
        <motion.a href="#" whileHover={{ scale: 1.2 }}>
          <FaGithub />
        </motion.a>
        <motion.a href="#" whileHover={{ scale: 1.2 }}>
          <FaLinkedin />
        </motion.a>
      </div>
    </ContactWrapper>
  );
}
```

### 9. Footer (src/components/Footer.tsx)

Finalize com um rodapé simples e funcional.

Design: Copyright e links sociais.
Interatividade: Ícones com animação e botão "voltar ao topo".
Implementação:

```
import styled from 'styled-components';
import { motion } from 'framer-motion';
import { FaGithub, FaLinkedin } from 'react-icons/fa';

const FooterWrapper = styled.footer`
  padding: 2rem;
  text-align: center;
  background: ${({ theme }) => theme.colors.primary};
  color: white;
`;

export default function Footer() {
  return (
    <FooterWrapper>
      <p>&copy; 2023 Rodrigo Cinelli</p>
      <div>
        <motion.a href="#" whileHover={{ scale: 1.2 }}>
